DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Auth: copy the Auth URL from Neon Console → Branch → Auth → Configuration.
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (project files). `neon env pull` writes the AWS_* values for the linked branch.
# After creating the bucket on a branch, run `npm run storage:cors` once so browsers can upload to it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET_NAME=files

# Encrypts client portal setup links so they can be copied again ("Recopy link").
# Generate with: openssl rand -base64 32
PORTAL_LINK_SECRET=

# Upstash Redis (rate limiting): console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (bot protection on sign-up/sign-in): dash.cloudflare.com → Turnstile → your widget.
# TURNSTILE_HOSTNAMES is a comma-separated list of the hostnames this deployment serves.
# Production must list only production hostnames, never localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Bachs (ClientVero subscription billing): docs.bachs.io. Use sk_sandbox_ keys locally; live keys only in production.
# Developer Portal → API Keys for the key; Webhooks → your /api/webhooks/bachs endpoint for the signing secret.
# Product ids are the monthly USD products for the Pro and Agency plans.
BACHS_API_KEY=sk_sandbox_7d3efb33_mO5yYCQbdOMlRIQbVOp1UFCuC6vGAGMiGxx3fya2WKE
BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_PRO=prod_5a91d96c4ed040b4b5a4
BACHS_PRODUCT_AGENCY=prod_d6b95262eed742628a6c

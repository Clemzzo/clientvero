DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Auth: copy the Auth URL from Neon Console → Branch → Auth → Configuration.
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Encrypts client portal setup links so they can be copied again ("Recopy link").
# Generate with: openssl rand -base64 32
PORTAL_LINK_SECRET=

# Upstash Redis (rate limiting): console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (bot protection on sign-up/sign-in): dash.cloudflare.com → Turnstile → your widget.
# TURNSTILE_HOSTNAMES is a comma-separated list of the hostnames this deployment serves.
# Production must list only production hostnames, never localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
